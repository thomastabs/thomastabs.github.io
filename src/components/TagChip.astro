---
/* Tag chip. `href` makes it a link. `kind` is accepted for compatibility and not rendered. */
type Kind = 'work' | 'study' | 'teaching' | 'community' | 'milestone';
interface Props { label: string; href?: string; kind?: Kind; count?: number; active?: boolean }
const { label, href, count, active = false } = Astro.props;
const Tag = href ? 'a' : 'span';
---
<Tag class:list={['chip', { active }]} href={href} aria-current={active && href ? 'page' : undefined}>
  <span>{label}</span>
  {count !== undefined && <span class="count">{count}</span>}
</Tag>
<style>
  .chip {
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
    padding: var(--s-1) var(--s-2);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-pill);
    font-size: var(--t-14);
    color: var(--ink-2);
    text-decoration: none;
    line-height: 1.3;
    white-space: nowrap;
    transition: border-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  a.chip:hover { border-color: var(--ink); color: var(--ink); }
  .chip.active { border-color: var(--ink); color: var(--ink); background: var(--surface-2); }
  .count { color: var(--muted); }
</style>
