---
import { useTranslations, getLangFromUrl } from '@/i18n';
interface Props { type?: 'note' | 'todo' | 'decision'; title?: string }
const { type = 'note', title } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));
const label = t(`callout.${type}` as const);
---
<aside class="callout" data-type={type}>
  <p class="callout-label">{label}{title && <span class="callout-title">: {title}</span>}</p>
  <div class="callout-body"><slot /></div>
</aside>
<style>
  .callout {
    padding: var(--s-3) var(--s-5);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .callout-label {
    font-size: var(--t-14);
    font-weight: 500;
    color: var(--ink);
    margin-bottom: var(--s-2);
  }
  .callout-title { color: var(--muted); font-weight: 400; }
  .callout-body :global(> * + *) { margin-top: var(--s-2); }
  .callout-body { color: var(--ink-2); }
</style>
