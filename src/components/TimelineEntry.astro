---
import OrgLogo from './OrgLogo.astro';
import type { LogoKey } from '@/lib/logos';
type Kind = 'work' | 'study' | 'teaching' | 'community' | 'milestone';
interface Props {
  id?: string;
  period: string;
  title: string;
  org?: string;
  /** Used only for filtering (data-tags); not rendered. */
  tags?: { kind: Kind; label: string }[];
  notesHref?: string;
  notesLabel?: string;
  /** Accepted for compatibility; the timeline shows no tech chips. */
  stack?: string[];
  headingLevel?: 'h2' | 'h3';
  /** Shows an organisation tile next to the title: a logo, or a monogram. */
  logo?: LogoKey;
  monogram?: string;
}
const { id, period, title, org, tags = [], notesHref, notesLabel = 'Read the notes', headingLevel: H = 'h3', logo, monogram } = Astro.props;
const withLogo = !!(logo || monogram);
---
<li class="tl-entry" id={id} data-tags={tags.map((t) => t.kind).join(' ')}>
  <span class="node" aria-hidden="true"></span>
  <p class="period date">{period}</p>
  <div class="body">
    <div class:list={['head', { 'has-logo': withLogo }]}>
      {withLogo && <OrgLogo logo={logo} monogram={monogram} name={org ?? title} />}
      <div>
        <H class="tl-title">{title}</H>
        {org && <p class="org">{org}</p>}
      </div>
    </div>
    <div class="desc"><slot /></div>
    {notesHref && <a class="pen-link notes" href={notesHref}>{notesLabel}</a>}
  </div>
</li>
<style>
  .head.has-logo { display: flex; gap: var(--s-3); align-items: flex-start; }
  .tl-entry {
    position: relative;
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    gap: var(--s-2) var(--s-6);
    padding: 0 0 var(--s-7) var(--s-6);
    list-style: none;
  }
  /* axis */
  .tl-entry::before {
    content: '';
    position: absolute;
    left: 5px;
    top: var(--s-3);
    bottom: calc(var(--s-2) * -1);
    width: 1px;
    background: var(--rule-strong);
  }
  .tl-entry:last-child::before { background: linear-gradient(var(--rule-strong), transparent); }
  .node {
    position: absolute;
    left: 0;
    top: 7px;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--ink-2);
  }
  .period { padding-top: var(--s-1); }
  .tl-title { font-size: var(--t-20); }
  .org { margin-top: var(--s-1); font-size: var(--t-16); color: var(--ink-2); }
  .desc:empty { display: none; }
  .desc { margin-top: var(--s-3); color: var(--ink-2); max-width: var(--measure); }
  .notes { display: inline-block; margin-top: var(--s-3); font-size: var(--t-16); }
  @media (max-width: 720px) {
    .tl-entry { grid-template-columns: 1fr; padding-left: var(--s-5); }
  }
</style>
