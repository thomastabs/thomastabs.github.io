---
/* Project card. `featured` = wide layout. `maxStack` caps the chips (4 on the home page).
   `status` shows only for unfinished work (`unfinished`). */
import TagChip from './TagChip.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  title: string;
  summary: string;
  year?: string;
  status?: string;
  stack?: string[];
  href?: string;
  links?: { label: string; href: string }[];
  internalLabel?: string;
  featured?: boolean;
  kicker?: string;
  cover?: ImageMetadata;
  coverAlt?: string;
  maxStack?: number;
  unfinished?: boolean;
}
const { title, summary, year, status, stack = [], href, links = [], internalLabel, featured = false, kicker, cover, coverAlt = '', maxStack, unfinished = false } = Astro.props;
const chips = maxStack ? stack.slice(0, maxStack) : stack;
---
<article class:list={['card', { featured, 'has-cover': featured && !!cover }]}>
  <h3 class="card-title">
    {href ? <a href={href} class="card-link">{title}</a> : title}
  </h3>
  <header class="card-head">
    <p class="meta">{kicker ?? 'Project'}{year && <span>, {year}</span>}</p>
    {status && unfinished && <p class="meta">{status}</p>}
  </header>
  <p class="summary">{summary}</p>
  {featured && cover && (
    <div class="shot">
      <Image src={cover} alt={coverAlt} widths={featured ? [640, 1040, 1400] : [400, 640]} sizes={featured ? '(min-width: 1100px) 1000px, 100vw' : '(min-width: 900px) 320px, 100vw'} loading="lazy" quality={75} />
    </div>
  )}
  <slot />
  {stack.length > 0 && (
    <ul class="chip-list" role="list">
      {chips.map((s) => <li><TagChip label={s} /></li>)}
    </ul>
  )}
  {(links.length > 0 || internalLabel) && (
    <footer class="card-links">
      {links.map((l) => <a class="pen-link" href={l.href}>{l.label}</a>)}
      {internalLabel && <span class="meta">{internalLabel}</span>}
    </footer>
  )}
</article>
<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding: var(--s-5);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    background: var(--surface);
    transition: border-color var(--dur) var(--ease);
  }
  .card:has(.card-link):hover { border-color: var(--ink); }
  .card-head { display: flex; justify-content: space-between; gap: var(--s-3); }
  .card-title { font-size: var(--t-20); }
  .card-link { text-decoration: none; }
  .card-link::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .card-link:focus-visible { outline: none; }
  .card:has(.card-link:focus-visible) { outline: 2px solid var(--ink); outline-offset: 4px; }
  .summary { color: var(--ink-2); }
  .chip-list > li { display: flex; }
  .chip-list { display: flex; flex-wrap: wrap; gap: var(--s-2); padding: 0; margin-top: auto; padding-top: var(--s-2); list-style: none; }
  .card-links { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-5); padding-top: var(--s-3); border-top: 1px solid var(--rule); font-size: var(--t-16); }
  .card-links a { position: relative; z-index: 1; }
  .card-links .meta { font-size: inherit; }
  .shot { border: 1px solid var(--rule); border-radius: var(--radius); overflow: hidden; background: var(--surface-2); }
  .shot :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; object-position: top left; }
  @media (min-width: 900px) {
    .featured.has-cover { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: var(--s-6); row-gap: var(--s-3); align-content: start; }
    .featured.has-cover > * { grid-column: 1; }
    .featured.has-cover > .shot { grid-column: 2; grid-row: 1 / span 6; align-self: start; }
    .featured.has-cover .shot :global(img) { aspect-ratio: 16 / 10; }
  }
  .featured { padding: var(--s-6); }
  .featured .card-title { font-size: var(--t-28); max-width: 24ch; }
  .featured .summary { font-size: var(--t-17); max-width: var(--measure); }
</style>
