---
/* Text-led spec-block card. `featured` = wide layout. Optional image → fig. caption. */
import TagChip from './TagChip.astro';
interface Props {
  title: string;
  summary: string;
  year?: string;
  status?: string;
  stack?: string[];
  href?: string;
  links?: { label: string; href: string }[];
  internalLabel?: string;
  featured?: boolean;
  kicker?: string;
}
const { title, summary, year, status, stack = [], href, links = [], internalLabel, featured = false, kicker } = Astro.props;
---
<article class:list={['card', { featured }]} data-reveal>
  <header class="card-head">
    <p class="kicker">{kicker ?? 'project'}{year && <span> · {year}</span>}</p>
    {status && <p class="status meta"><span class="status-dot" aria-hidden="true"></span>{status}</p>}
  </header>
  <h3 class="card-title">
    {href ? <a href={href} class="card-link">{title}</a> : title}
  </h3>
  <p class="summary">{summary}</p>
  <slot />
  {stack.length > 0 && (
    <ul class="chip-list" role="list">
      {stack.map((s) => <li><TagChip label={s} /></li>)}
    </ul>
  )}
  {(links.length > 0 || internalLabel) && (
    <footer class="card-links">
      {links.map((l) => <a class="pen-link mono" href={l.href}>{l.label} {l.href.startsWith("http") ? "↗" : "→"}</a>)}
      {internalLabel && <span class="meta">{internalLabel}</span>}
    </footer>
  )}
</article>
<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding: var(--s-5);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    background: var(--surface);
    transition: border-color var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  .card:has(.card-link):hover { border-color: var(--ink); }
  .card-head { display: flex; justify-content: space-between; gap: var(--s-3); padding-bottom: var(--s-3); border-bottom: 1px dashed var(--rule-strong); }
  .status { display: inline-flex; align-items: center; gap: 0.45em; text-transform: uppercase; }
  .status-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--tag-teaching); }
  .card-title { font-size: var(--step-2); }
  .card-link { text-decoration: none; }
  .card-link::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .card-link:focus-visible { outline: none; }
  .card:has(.card-link:focus-visible) { outline: 2px solid var(--pen); outline-offset: 3px; }
  .summary { color: var(--ink-2); }
  .chip-list > li { display: flex; }
  .chip-list { display: flex; flex-wrap: wrap; gap: var(--s-2); padding: 0; margin-top: auto; padding-top: var(--s-2); list-style: none; }
  .card-links { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-5); padding-top: var(--s-3); border-top: 1px solid var(--rule); font-size: var(--step--1); }
  .card-links a { position: relative; z-index: 1; }
  .featured { padding: var(--s-6); }
  .featured .card-title { font-size: var(--step-3); max-width: 24ch; }
  .featured .summary { font-size: var(--step-1); max-width: 56ch; }
</style>
