---
/* §NN — Label kicker + serif title. Title optional (label-only for compact sections).
   The kicker is a full-width rule with the label (and optional `meta`) centred. */
interface Props { n: number | string; label: string; title?: string; id?: string; level?: 'h1' | 'h2'; meta?: string }
const { n, label, title, id, level = 'h2', meta } = Astro.props;
const num = typeof n === 'number' ? String(n).padStart(2, '0') : n;
const Tag = level;
---
<div class="section-heading">
  <p class="kicker section-label"><span class="label-text"><span class="pen">§{num}</span> — {label}{meta && <span class="meta"> · {meta}</span>}</span></p>
  {title ? <Tag id={id} class="section-title">{title}</Tag> : <Tag id={id} class="sr-only">{label}</Tag>}
  <slot />
</div>
<style>
  .section-heading { margin-bottom: var(--s-6); }
  /* Full-width rule with the label centred: ──── §03 — EDUCATION · 2018 → 2026 ──── */
  .section-label { display: flex; align-items: center; gap: var(--s-4); }
  .section-label::before,
  .section-label::after { content: ''; flex: 1 1 0; min-width: var(--s-5); height: 1px; background: var(--rule-strong); }
  .label-text { flex: 0 1 auto; text-align: center; }
  .meta { color: var(--muted); }
  .section-title { margin-top: var(--s-3); max-width: 22ch; }
</style>
