---
/* "Part 2 of 4 · Apex notes": every part of the series, current one marked, with prev/next. */
import { useTranslations, type Locale } from '@/i18n';
import { postHref, seriesHref, seriesLabel, type Post } from '@/lib/notebook';
interface Props { parts: Post[]; current: Post; series: string; lang: Locale }
const { parts, current, series, lang } = Astro.props;
const t = useTranslations(lang);
const i = parts.findIndex((p) => p.id === current.id);
const prev = parts[i - 1];
const next = parts[i + 1];
const heading = t('notebook.seriesPart').replace('{n}', String(i + 1)).replace('{total}', String(parts.length));
---
<aside class="series" aria-labelledby="series-h">
  <p class="kicker" id="series-h">
    {heading} · <a class="pen-link" href={seriesHref(series, lang)}>{seriesLabel(series)}</a>
  </p>
  <ol>
    {parts.map((p) => (
      <li>
        {p.id === current.id
          ? <span aria-current="page">{p.data.title}</span>
          : <a href={postHref(p)}>{p.data.title}</a>}
      </li>
    ))}
  </ol>
  {(prev || next) && (
    <p class="series-nav">
      {prev && <a href={postHref(prev)} rel="prev">← {t('post.prev')}</a>}
      {next && <a href={postHref(next)} rel="next">{t('post.next')} →</a>}
    </p>
  )}
</aside>
<style>
  .series { padding: var(--s-3) var(--s-5); border: 1px solid var(--rule-strong); border-radius: var(--radius); background: var(--surface); max-width: var(--measure); }
  .series ol { margin: var(--s-3) 0 0; padding-left: var(--s-5); display: grid; gap: var(--s-1); }
  .series li::marker { color: var(--muted); }
  .series a { color: var(--ink-2); }
  .series [aria-current] { color: var(--ink); font-weight: 500; }
  .series-nav { display: flex; justify-content: space-between; gap: var(--s-3); margin-top: var(--s-3); font-size: var(--t-16); }
  .series-nav a { text-decoration: none; color: var(--ink); }
  .series-nav a:hover { color: var(--pen); }
  .series-nav a[rel='next'] { margin-left: auto; }
</style>
