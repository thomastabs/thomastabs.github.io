---
/* Right-margin annotation. Use inside .annotated; collapses inline under 1100px. */
interface Props { mark?: boolean }
const { mark = true } = Astro.props;
---
<aside class="margin-note">
  {mark && <span class="arrow" aria-hidden="true">←</span>}
  <slot />
</aside>
<style>
  .margin-note {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    line-height: 1.55;
    letter-spacing: var(--tracking-mono);
    color: var(--ink-2);
    padding: var(--s-2) var(--s-3);
    border-left: 1px solid var(--pen);
    background: var(--pen-soft);
    max-width: 40ch;
  }
  .arrow { display: none; color: var(--pen); margin-right: 0.4em; }
  @media (min-width: 1100px) {
    .margin-note {
      grid-column: 2;
      background: none;
      padding: 0.2rem 0 0;
      border-left: 0;
      position: sticky;
      top: calc(var(--header-h) + 1.5rem);
    }
    .arrow { display: inline; }
  }
</style>
