---
/* Hero centrepiece: hand-drawn journey graph on graph paper.
   Inline SVG, no libraries. Draws in once (skipped with reduced motion).
   Hover/focus a node → mono annotation. Click → scrolls to the entry.
   <720px: a vertical path through the main stops, lit from the past to the next stop. */
import { nodes, edges, traces, phonePath } from '@/data/journey-graph';
import { useTranslations, type Locale } from '@/i18n';
import { localePath } from '@/i18n/routes';

interface Props {
  lang: Locale;
  /** Anchor ids present on the current page; others link to /journey (or Home for contact). */
  localAnchors?: string[];
}
const { lang, localAnchors = [] } = Astro.props;
const t = useTranslations(lang);

const W = 640;
const H = 460;
const byId = Object.fromEntries(nodes.map((n) => [n.id, n]));

function curve(a: string, b: string, bend: number) {
  const p = byId[a];
  const q = byId[b];
  const mx = (p.x + q.x) / 2;
  const my = (p.y + q.y) / 2;
  const dx = q.x - p.x;
  const dy = q.y - p.y;
  const len = Math.hypot(dx, dy) || 1;
  const cx = mx + (-dy / len) * bend;
  const cy = my + (dx / len) * bend;
  return `M${p.x} ${p.y}Q${cx.toFixed(1)} ${cy.toFixed(1)} ${q.x} ${q.y}`;
}

const label = (n: (typeof nodes)[number]) => {
  switch (n.side) {
    case 'right': return { x: n.x + 16, y: n.y + 6, anchor: 'start' };
    case 'left': return { x: n.x - 16, y: n.y + 6, anchor: 'end' };
    case 'above': return { x: n.x, y: n.y - 18, anchor: 'middle' };
    default: return { x: n.x, y: n.y + 32, anchor: 'middle' };
  }
};

const CHAR = 9.6; // IBM Plex Mono @ 16 units ≈ 0.6em advance
const anno = (n: (typeof nodes)[number]) => {
  const lines = [n.role[lang], n.years[lang]];
  const w = Math.ceil(Math.max(...lines.map((l) => l.length)) * CHAR + 24);
  const h = 60;
  // Above the node, unless that would leave the top of the viewBox.
  const below = n.y - h - 18 < 0;
  const x = Math.max(4, Math.min(W - w - 4, n.x - w / 2));
  const y = below ? n.y + 18 : n.y - h - 18;
  return { x, y, w, h, lines };
};

const href = (anchor: string) =>
  localAnchors.includes(anchor)
    ? `#${anchor}`
    : anchor === 'contact'
      ? localePath('contact', lang)
      : `${localePath('journey', lang)}#${anchor}`;

/* Phone path: newest stop on top, so it reads like the timelines below. Each row is ROW tall. */
const ROW = 64;
const PX = [24, 36, 16, 34, 20];
const phoneStops = phonePath.map((id, i) => ({ ...byId[id], px: PX[i % PX.length], py: ROW * i + ROW / 2 }));
const phoneH = ROW * phoneStops.length;
const phoneCurve = (i: number, off = 0) => {
  const a = phoneStops[i + 1];
  const b = phoneStops[i];
  return `M${a.px} ${a.py}Q${(a.px + b.px) / 2 + (i % 2 ? 11 : -11) + off} ${(a.py + b.py) / 2} ${b.px} ${b.py}`;
};
---

<div class="journey" data-journey>
  <svg
    class="graph"
    viewBox={`0 0 ${W} ${H}`}
    role="group"
    aria-labelledby="jg-title jg-desc"
  >
    <title id="jg-title">{t('graph.title')}</title>
    <desc id="jg-desc">{t('graph.desc')}</desc>

    <g class="edges" aria-hidden="true">
      {traces.map(([a, b, bend]) => <path class="trace" data-a={a} data-b={b} d={curve(a, b, bend)} />)}
      {edges.map(([a, b, bend], i) => (
        <>
          <path class="edge ghost" data-a={a} data-b={b} d={curve(a, b, bend + 3.5)} pathLength="1" style={`--i:${i}`} />
          <path class:list={['edge', { future: byId[b].future }]} data-a={a} data-b={b} d={curve(a, b, bend)} pathLength="1" style={`--i:${i}`} />
        </>
      ))}
    </g>

    <g class="nodes">
      {nodes.map((n, i) => {
        const l = label(n);
        return (
          <a
            class="node"
            href={href(n.anchor)}
            data-node={n.id}
            data-kind={n.kind}
            data-future={n.future ? '' : undefined}
            aria-label={`${n.label[lang]}: ${n.role[lang]}, ${n.years[lang]}`}
            style={`--i:${i}`}
          >
            <circle class="hit" cx={n.x} cy={n.y} r="18" />
            {n.kind === 'milestone' && !n.future && <circle class="ring" cx={n.x} cy={n.y} r="11.5" />}
            <circle class="dot" cx={n.x} cy={n.y} r={n.future ? 8 : 7.5} />
            <text class="label" x={l.x} y={l.y} text-anchor={l.anchor}>{n.label[lang]}</text>
          </a>
        );
      })}
    </g>

    <g class="annos" aria-hidden="true">
      {nodes.map((n) => {
        const a = anno(n);
        return (
          <g class="anno" data-anno={n.id}>
            <rect x={a.x} y={a.y} width={a.w} height={a.h} rx="4" />
            <line x1={a.x + 12} y1={a.y + 31} x2={a.x + a.w - 12} y2={a.y + 31} />
            <text x={a.x + 12} y={a.y + 22}>{a.lines[0]}</text>
            <text class="yrs" x={a.x + 12} y={a.y + 50}>{a.lines[1]}</text>
          </g>
        );
      })}
    </g>
  </svg>

  <div class="phone">
    <div class="p-wrap">
      <svg class="p-svg" width="52" height={phoneH} viewBox={`0 0 52 ${phoneH}`} aria-hidden="true">
        {phoneStops.slice(0, -1).map((_, i) => {
          const order = phoneStops.length - 2 - i;
          return (
            <>
              <path class="edge ghost p-edge" d={phoneCurve(i, 3)} pathLength="1" style={`--i:${order}`} />
              <path class:list={['edge p-edge', { future: phoneStops[i].future }]} d={phoneCurve(i)} pathLength="1" style={`--i:${order}`} />
            </>
          );
        })}
        {phoneStops.map((n, i) => (
          <circle class:list={['dot p-dot', { 'p-next': n.future }]} cx={n.px} cy={n.py} r={n.future ? 8 : 6} style={`--i:${phoneStops.length - 1 - i}`} />
        ))}
      </svg>
      <ol class="p-list" role="list" aria-label={t('graph.title')}>
        {phoneStops.map((n) => (
          <li>
            <a href={href(n.anchor)}>
              <span class="p-label">{n.label[lang]}</span>
              <span class="p-years">{n.years[lang]}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
    <a class="pen-link p-all" href={localePath('journey', lang)}>{t('cta.fullJourney')}</a>
  </div>

</div>

<style>
  .journey {
    --k: var(--ink-2);
    position: relative;
  }

  .graph {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* ---------- Edges ---------- */
  .edge {
    fill: none;
    stroke: var(--ink-2);
    stroke-width: 1.6;
    stroke-linecap: round;
  }
  .edge.ghost {
    stroke-width: 0.8;
    opacity: 0.35;
  }
  .edge.future {
    stroke-dasharray: 0.02 0.025;
  }
  .trace {
    fill: none;
    stroke: var(--ink-2);
    stroke-width: 1;
    stroke-dasharray: 2 5;
    stroke-linecap: round;
    opacity: 0.55;
  }

  /* ---------- Nodes ---------- */

  .node { cursor: pointer; outline: none; }
  .hit { fill: transparent; }
  .dot {
    fill: var(--k);
    stroke: var(--bg);
    stroke-width: 2.5;
    paint-order: stroke;
    transition: r var(--dur) var(--ease);
  }
  /* The one accent in the graph: where I am going next. */
  [data-future] .dot { fill: var(--pen); }
  .ring {
    fill: none;
    stroke: var(--ink-2);
    stroke-width: 1.1;
    stroke-dasharray: 64 8;
    transform-box: fill-box;
    transform-origin: center;
    transform: rotate(-30deg);
  }
  /* The graph renders at ~0.84x (540px of a 640 viewBox): 18 units ≈ 15px on screen. */
  .label {
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 500;
    fill: var(--ink);
    paint-order: stroke;
    stroke: var(--bg);
    stroke-width: 4px;
    stroke-linejoin: round;
  }
  .node:hover .dot,
  .node:focus-visible .dot { r: 10; }
  .node:focus-visible .hit {
    stroke: var(--ink);
    stroke-width: 1.5;
    stroke-dasharray: 3 3;
  }
  .node:hover .label,
  .node:focus-visible .label { fill: var(--pen); }

  /* ---------- Annotations ---------- */
  .anno {
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur) var(--ease);
  }
  .anno.on { opacity: 1; }
  .anno rect {
    fill: var(--surface);
    stroke: var(--rule-strong);
  }
  .anno line { stroke: var(--rule); }
  .anno text {
    font-family: var(--font-body);
    font-size: 16px;
    fill: var(--ink);
  }
  .anno .yrs { fill: var(--muted); font-family: var(--font-mono); }

  /* ---------- Tracing: pointing at a stop lights the path that led to it ---------- */
  .edge, .trace, .dot, .ring, .label { transition: stroke var(--dur) var(--ease), fill var(--dur) var(--ease); }
  .tracing .edge:not(.lit), .tracing .trace:not(.lit), .tracing .ring { stroke: var(--rule-strong); }
  .tracing .node:not(.lit) .dot { fill: var(--rule-strong); }
  .tracing .node:not(.lit) .label { fill: var(--muted); }
  .edge.lit, .trace.lit { stroke: var(--pen); }
  .node.lit .dot { fill: var(--pen); }

  /* ---------- Draw-in (once, motion OK only) ---------- */
  @media (prefers-reduced-motion: no-preference) {
    .edge:not(.future) {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: draw 520ms var(--ease) forwards;
      animation-delay: calc(var(--i) * 170ms + 120ms);
    }
    .edge.future {
      opacity: 0;
      animation: fade 400ms var(--ease) forwards;
      animation-delay: calc(var(--i) * 170ms + 280ms);
    }
    .node,
    .trace {
      opacity: 0;
      animation: fade 360ms var(--ease) forwards;
      animation-delay: calc(var(--i) * 170ms);
    }
    .trace { animation-delay: 1.6s; }
  }

  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes fade { to { opacity: 1; } }

  /* ---------- Phone path ---------- */
  .phone { display: none; }

  @media (max-width: 720px) {
    .graph { display: none; }
    .phone { display: block; }
    .p-wrap { position: relative; }
    .p-svg { position: absolute; top: 0; left: 0; overflow: visible; pointer-events: none; }
    .p-edge { stroke: var(--pen); }
    .p-next { fill: var(--pen); }
    .p-list { margin: 0; padding: 0; list-style: none; }
    .p-list a {
      display: flex;
      flex-direction: column;
      justify-content: center;
      height: 64px;
      padding-left: 60px;
      color: inherit;
      text-decoration: none;
    }
    .p-label { font-size: var(--t-16); font-weight: 500; color: var(--ink); line-height: 1.3; }
    .p-years { font-family: var(--font-mono); font-size: var(--t-14); color: var(--ink-2); line-height: 1.4; }
    .p-all { margin-top: var(--s-3); }
  }
  @media (max-width: 720px) and (prefers-reduced-motion: no-preference) {
    .p-dot { opacity: 0; animation: fade 300ms var(--ease) forwards; animation-delay: calc(var(--i) * 170ms); }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-journey]').forEach((root) => {
    const paths = [...root.querySelectorAll<SVGPathElement>('path[data-a]')];
    const graph = root.querySelector('.graph');
    const show = (id: string | undefined, on: boolean) => {
      if (!id) return;
      root.querySelector(`[data-anno="${id}"]`)?.classList.toggle('on', on);
      graph?.classList.toggle('tracing', on);
      root.querySelectorAll('.lit').forEach((el) => el.classList.remove('lit'));
      if (!on) return;
      // Walk back from this stop through every edge that leads to it.
      const seen = new Set([id]);
      for (const stop of seen) {
        for (const p of paths) {
          if (p.dataset.b !== stop) continue;
          p.classList.add('lit');
          seen.add(p.dataset.a!);
        }
      }
      seen.forEach((n) => root.querySelector(`[data-node="${n}"]`)?.classList.add('lit'));
    };
    root.querySelectorAll<SVGAElement>('[data-node]').forEach((a) => {
      const id = a.dataset.node;
      a.addEventListener('pointerenter', () => show(id, true));
      a.addEventListener('pointerleave', () => show(id, false));
      a.addEventListener('focus', () => show(id, true));
      a.addEventListener('blur', () => show(id, false));
    });
  });
</script>
