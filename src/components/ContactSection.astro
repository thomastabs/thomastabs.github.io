---
/* §06 Contact: the mountain scene with the form and direct links. Used at the end of the
   home page and as the whole of /contact (level="h1" there). */
import { getImage } from 'astro:assets';
import SectionHeading from './SectionHeading.astro';
import ContactForm from './ContactForm.astro';
import CopyButton from './CopyButton.astro';
import sceneWide from '@/assets/portrait/scene-wide.jpg';
import sceneTall from '@/assets/portrait/scene-tall.jpg';
import { useTranslations, type Locale } from '@/i18n';
import { profile } from '@/data/links';

interface Props { lang: Locale; level?: 'h1' | 'h2' }
const { lang, level = 'h2' } = Astro.props;
const t = useTranslations(lang);
const wide = await Promise.all([960, 1440, 1920].map((w) => getImage({ src: sceneWide, width: w, format: 'webp', quality: 78 })));
const tall = await Promise.all([480, 800, 1080].map((w) => getImage({ src: sceneTall, width: w, format: 'webp', quality: 78 })));
const srcset = (imgs: { src: string; options: { width?: number } }[]) => imgs.map((i) => `${i.src} ${i.options.width}w`).join(', ');
---
  <section class="contact" id="contact" aria-labelledby="contact-title">
    <div class="scene" data-reveal={level === 'h1' ? '' : undefined}>
      <div class="container scene-head" data-theme="dark">
        <SectionHeading n={6} label={t('section.contact')} title={t('contact.title')} id="contact-title" level={level} meta={lang === 'pt' ? '2026 → a seguir' : '2026 → next'} />
        <p class="lead contact-lead">{t('contact.lead')}</p>
      </div>
      <picture class="scene-img">
        <source media="(max-width: 760px)" type="image/webp" srcset={srcset(tall)} sizes="100vw" />
        <source type="image/webp" srcset={srcset(wide)} sizes="100vw" />
        <img src={wide[1].src} alt={t('contact.sceneAlt')} width="1920" height="1080" loading={level === 'h1' ? 'eager' : 'lazy'} fetchpriority={level === 'h1' ? 'high' : undefined} decoding="async" />
      </picture>
      <div class="container scene-inner">
        <div class="scene-card">
          <ContactForm lang={lang} />
          <div class="direct">
            <p class="kicker">{t('contact.or')}</p>
            <p class="email mono">{profile.email}</p>
            <div class="btn-set">
              <CopyButton variant="primary" value={profile.email} label={t('cta.copyEmail')} copiedLabel={t('cta.copied')} />
              <a class="btn" href={profile.linkedin} rel="me">LinkedIn ↗</a>
              <a class="btn" href={profile.github} rel="me">GitHub ↗</a>
              <a class="btn btn--ghost pen-link pen-link--bare" href={profile.cv} download>{t('cta.downloadCv')}</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

<style>
  .email { margin: var(--s-2) 0 var(--s-4); font-size: var(--step-1); color: var(--ink); word-break: break-all; }

  /* §06: the old portfolio's mountain scene as the backdrop, form on a paper card */
  .contact-lead { max-width: 56ch; }
  @media (max-width: 480px) { .direct .email { font-size: var(--step-0); overflow-wrap: anywhere; } }
  /* The scene is a dusk photo: its heading always uses the dark tokens (data-theme="dark"
     on .scene-head) and the washes use a fixed near-black, while the form cards follow the
     page theme. In dark mode it fades into the page; in light mode it keeps a clean edge,
     because fading a pale page into a dark sky only makes grey. */
  .contact { --night: 10, 10, 10; --edge: 0%; }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme='light'])) .contact { --edge: 8%; } }
  :global(:root[data-theme='dark']) .contact { --edge: 8%; }
  .scene { position: relative; isolation: isolate; background: rgb(var(--night)); }
  .scene-head { padding-top: var(--s-8); }
  .scene-img img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .scene-card { display: grid; gap: var(--s-5); }
  .direct { padding: var(--s-4) var(--s-5); background: color-mix(in srgb, var(--surface) 92%, transparent); border: 1px solid var(--rule-strong); border-radius: var(--radius); backdrop-filter: blur(6px); }
  @media (min-width: 761px) {
    .scene { min-height: clamp(860px, 66vw, 1100px); display: flex; flex-direction: column; }
    .scene-img { position: absolute; inset: 0; z-index: -2; }
    .scene-img img { object-position: 72% 40%; }
    /* Two washes: a short top/bottom fade into the page, and a left-hand wash so the
       heading, lead and form stay readable in both themes while the right stays photo. */
    .scene::before { content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
      background: linear-gradient(to right, rgba(var(--night), 0.88) 0, rgba(var(--night), 0.55) 38%, transparent 62%); }
    .scene::after { content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
      background: linear-gradient(to bottom, var(--bg) 0, transparent var(--edge), transparent calc(100% - var(--edge) * 1.25), var(--bg) 100%); }
    .scene-head { padding-top: var(--s-8); }
    .scene-head .contact-lead { color: var(--ink); }
    .scene-inner { width: 100%; padding-block: var(--s-6) var(--s-8); }
    .scene-card { max-width: 34rem; }
  }
  @media (max-width: 760px) {
    .scene-img img { aspect-ratio: 4 / 5; object-position: 50% 20%; }
    .scene-inner { margin-top: calc(var(--s-8) * -1.5); position: relative; padding-bottom: var(--s-6); }
  }
  /* /contact only: a light entrance on load. The photo settles from a slight zoom while the
     heading, lead and cards rise in turn. (On the home page the scene is static.) */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .scene[data-reveal] { opacity: 1; transform: none; }
    :global(.js) .scene[data-reveal] .scene-img img { opacity: 0; transform: scale(1.06); transition: opacity 1.2s var(--ease), transform 2.4s var(--ease); }
    :global(.js) .scene[data-reveal] :global(.section-heading),
    :global(.js) .scene[data-reveal] .contact-lead,
    :global(.js) .scene[data-reveal] .scene-card > * { opacity: 0; transform: translateY(14px); transition: opacity 0.7s var(--ease), transform 0.7s var(--ease); }
    :global(.js) .scene.is-visible .scene-img img,
    :global(.js) .scene.is-visible :global(.section-heading),
    :global(.js) .scene.is-visible .contact-lead,
    :global(.js) .scene.is-visible .scene-card > * { opacity: 1; transform: none; }
    :global(.js) .scene.is-visible .contact-lead { transition-delay: 0.12s; }
    :global(.js) .scene.is-visible .scene-card > :first-child { transition-delay: 0.26s; }
    :global(.js) .scene.is-visible .scene-card > :nth-child(2) { transition-delay: 0.4s; }
  }
</style>
