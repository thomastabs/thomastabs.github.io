---
/* Figure with mono caption: fig. 03 — Apex architecture. Pass an image via slot. */
interface Props { n: number | string; caption: string; taped?: boolean; class?: string }
const { n, caption, taped = false, class: cls } = Astro.props;
const num = typeof n === 'number' ? String(n).padStart(2, '0') : n;
---
<figure class:list={['fig', cls, { taped }]}>
  <div class="fig-media"><slot /></div>
  <figcaption><span class="pen">fig. {num}</span> — {caption}</figcaption>
</figure>
<style>
  .fig-media { position: relative; border: 1px solid var(--rule); border-radius: var(--radius-sm); overflow: hidden; background: var(--surface-2); }
  .fig-media :global(img) { width: 100%; }
  figcaption {
    margin-top: var(--s-2);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: var(--tracking-mono);
    color: var(--muted);
  }
  /* Taped-in photo */
  .taped .fig-media {
    overflow: visible;
    padding: 10px 10px 0;
    background: var(--surface);
    border-color: var(--rule-strong);
    box-shadow: var(--shadow-tape);
    transform: rotate(-1.2deg);
  }
  .taped .fig-media :global(img) { border-radius: 1px; }
  .taped .fig-media::before,
  .taped .fig-media::after {
    content: '';
    position: absolute;
    top: -12px;
    width: 76px;
    height: 24px;
    background: var(--tape);
    backdrop-filter: blur(1px);
  }
  .taped .fig-media::before { left: 14%; transform: rotate(-6deg); }
  .taped .fig-media::after { right: 14%; transform: rotate(5deg); }
  .taped figcaption { padding: var(--s-2) 0 var(--s-3); transform: rotate(-1.2deg); }
  .taped .fig-media + figcaption { margin-top: 0; }
</style>
