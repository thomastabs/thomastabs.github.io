---
/* The Apex card, the same on the home and work pages: the phase diagram, or a phase list on phones. */
import PhaseStrip from './PhaseStrip.astro';
import { phases } from '@/data/apex';
import type { Locale } from '@/i18n';

interface Props {
  lang: Locale;
  title: string;
  summary: string;
  year?: string;
  kicker?: string;
  href?: string;
  links?: { label: string; href: string }[];
}
const { lang, title, summary, year, kicker, href, links = [] } = Astro.props;
---
<article class="apex-feature">
  <h3 class="apex-feature-title"><a href={href}>{title}</a></h3>
  <p class="meta">{kicker}, {year}</p>
  <p class="apex-feature-summary">{summary}</p>
  <div class="apex-diagram"><PhaseStrip lang={lang} fit /></div>
  <ol class="phase-list" role="list">
    {phases.map((p) => <li>{p.name[lang]}</li>)}
  </ol>
  <div class="apex-feature-links">
    {links.map((l) => <a class="pen-link" href={l.href}>{l.label}</a>)}
  </div>
</article>
<style>
  .apex-feature { display: grid; gap: var(--s-3); padding: var(--s-6); border: 1px solid var(--rule-strong); border-radius: var(--radius); background: var(--surface); }
  .apex-feature-title { font-size: var(--t-40); line-height: 1.1; }
  .apex-feature-title a { text-decoration: none; }
  .apex-feature-title a:hover { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.15em; }
  .apex-feature-summary { font-size: var(--t-17); color: var(--ink-2); max-width: var(--measure); }
  .apex-diagram { display: none; margin-block: var(--s-5) var(--s-3); }
  .apex-diagram :global(.strip-scroll) { overflow: visible; margin: 0; padding: 0; }
  .apex-diagram :global(.phase-strip) { min-width: 0; }
  .phase-list { display: grid; gap: var(--s-1); margin: var(--s-2) 0; padding: 0; list-style: none; counter-reset: phase; }
  .phase-list li { counter-increment: phase; display: flex; gap: var(--s-2); padding-block: var(--s-1); border-top: 1px solid var(--rule); }
  .phase-list li::before { content: 'P' counter(phase); width: 2rem; flex: none; font-family: var(--font-mono); font-size: var(--t-14); line-height: 1.7; color: var(--muted); }
  .apex-feature-links { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-5); padding-top: var(--s-3); border-top: 1px solid var(--rule); font-size: var(--t-16); }
  @media (min-width: 761px) {
    .apex-diagram { display: block; }
    .phase-list { display: none; }
  }
</style>
