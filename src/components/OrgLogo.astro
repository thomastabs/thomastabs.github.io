---
/* A small square tile with an organisation's mark, or its initials when there is none. */
import { Image } from 'astro:assets';
import { logos, type LogoKey } from '@/lib/logos';

interface Props { logo?: LogoKey; monogram?: string; name: string }
const { logo, monogram, name } = Astro.props;
const src = logo ? logos[logo] : undefined;
const initials = monogram ?? name.split(/\s+/).filter((w) => /^[A-ZÁÉÍÓÚ]/.test(w)).map((w) => w[0]).join('').slice(0, 3);
---
<span class="org-logo" aria-hidden="true">
  {src ? <Image src={src} alt="" width={44} height={44} densities={[1, 2]} /> : <span class="mono-tile">{initials}</span>}
</span>
<style>
  .org-logo {
    flex: none; display: grid; place-items: center;
    width: 44px; height: 44px; border-radius: var(--radius);
    background: var(--tile-bg); border: 1px solid var(--rule-strong); overflow: hidden;
  }
  .org-logo :global(img) { width: 78%; height: 78%; object-fit: contain; }
  .mono-tile { font-size: var(--t-14); font-weight: 500; color: var(--tile-ink); }
</style>
