---
/* Key–value panel with ruled rows. Values may be strings or rich (via slot "row-<key>"). */
export interface SpecRow { k: string; v?: string; href?: string; mono?: boolean }
interface Props { rows: SpecRow[]; title?: string; compact?: boolean }
const { rows, title, compact = false } = Astro.props;
---
<div class:list={['spec', { compact }]}>
  {title && <p class="spec-title kicker">{title}</p>}
  <dl>
    {rows.map((r) => (
      <div class="row">
        <dt>{r.k}</dt>
        <dd class:list={{ mono: r.mono }}>
          {r.href ? <a class="pen-link" href={r.href}>{r.v}</a> : r.v}
        </dd>
      </div>
    ))}
  </dl>
  <slot />
</div>
<style>
  .spec {
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    background: var(--surface);
    padding: var(--s-2) var(--s-5);
  }
  .spec-title {
    padding: var(--s-3) 0 var(--s-2);
    border-bottom: 1px solid var(--rule-strong);
    color: var(--muted);
  }
  dl { margin: 0; }
  .row {
    display: grid;
    grid-template-columns: minmax(6.5rem, 9rem) minmax(0, 1fr);
    gap: var(--s-4);
    padding: var(--s-3) 0;
    border-bottom: 1px solid var(--rule);
  }
  .row:last-child { border-bottom: 0; }
  dt {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--muted);
    padding-top: 0.2em;
  }
  dd { margin: 0; color: var(--ink); }
  dd.mono { font-family: var(--font-mono); font-size: var(--step--1); }
  .compact .row { padding: var(--s-2) 0; }
  @media (max-width: 480px) {
    .spec { padding-inline: var(--s-4); }
    .row { grid-template-columns: 1fr; gap: var(--s-1); }
  }
</style>
