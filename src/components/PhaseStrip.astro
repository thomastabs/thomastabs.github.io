---
/* fig. 01 — the framework's six lifecycle phases, their gates, the three governed
   loop-backs out of Maintenance, and the versioned specification every phase anchors to.
   Drawn from Figure 1 of the extended abstract (dissertation Figure 6.1). */
import { phases, loopBacks } from '@/data/apex';
import type { Locale } from '@/i18n';

interface Props { lang: Locale }
const { lang } = Astro.props;

const lines: Record<string, Record<Locale, string[]>> = {
  discovery: { en: ['Discovery &', 'Requirements'], pt: ['Descoberta e', 'Requisitos'] },
  design: { en: ['Design,', 'Prototyping &', 'Architecture'], pt: ['Design,', 'Prototipagem e', 'Arquitetura'] },
  implementation: { en: ['Implementation'], pt: ['Implementação'] },
  testing: { en: ['Testing'], pt: ['Testes'] },
  deployment: { en: ['Deployment'], pt: ['Implantação'] },
  maintenance: { en: ['Maintenance'], pt: ['Manutenção'] },
};

const W = 1000, H = 290;
const BX = 140, BW = 122, GAP = 26, BY = 70, BH = 78;
const x = (i: number) => BX + i * (BW + GAP);
const cx = (i: number) => x(i) + BW / 2;
const idx = Object.fromEntries(phases.map((p, i) => [p.id, i]));
const maint = phases.length - 1;
const t = {
  sa: lang === 'pt' ? ['Alinhamento', 'Estratégico'] : ['Strategic', 'Alignment'],
  spec: lang === 'pt' ? 'especificação persistente e versionada · camada global + local' : 'persistent, versioned specification · global + local layers',
  gate: lang === 'pt' ? 'portão' : 'gate',
  title: lang === 'pt' ? 'As seis fases do ciclo de vida da framework' : 'The framework’s six lifecycle phases',
  desc:
    lang === 'pt'
      ? 'Alinhamento Estratégico, depois seis fases em sequência, cada uma com um portão de qualidade. A Manutenção tem três retornos governados: defeito em produção para a Implementação, lacuna na especificação para o Design, desvio de negócio para a Descoberta. Todas as fases se ancoram numa especificação versionada.'
      : 'Strategic Alignment, then six sequential phases, each closed by a quality gate. Maintenance has three governed loop-backs: production defect to Implementation, specification gap to Design, business deviation to Discovery. Every phase anchors to a versioned specification.',
};
---

<div class="strip-scroll">
  <svg class="phase-strip" viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="ps-title ps-desc">
    <title id="ps-title">{t.title}</title>
    <desc id="ps-desc">{t.desc}</desc>
    <defs>
      <marker id="ps-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 10 5 0 10z" class="arrowhead" />
      </marker>
      <marker id="ps-arrow-pen" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 10 5 0 10z" class="arrowhead-pen" />
      </marker>
    </defs>

    <!-- spec band -->
    <rect class="spec-band" x={BX} y="8" width={x(maint) + BW - BX} height="24" rx="3" />
    <text class="spec-text" x={(BX + x(maint) + BW) / 2} y="24" text-anchor="middle">{t.spec}</text>
    {phases.map((_, i) => <line class="anchor" x1={cx(i)} y1="32" x2={cx(i)} y2={BY} />)}

    <!-- strategic alignment -->
    <rect class="sa" x="4" y={BY + 8} width="108" height={BH - 16} rx="4" />
    {t.sa.map((l, j) => <text class="sa-text" x="58" y={BY + BH / 2 - 3 + j * 15} text-anchor="middle">{l}</text>)}
    <line class="flow" x1="112" y1={BY + BH / 2} x2={BX - 3} y2={BY + BH / 2} marker-end="url(#ps-arrow)" />

    <!-- phases -->
    {phases.map((p, i) => {
      const ls = lines[p.id][lang];
      const top = BY + BH / 2 - ((ls.length - 1) * 15) / 2 + 8;
      return (
        <g class:list={['phase', { last: i === maint }]}>
          <rect x={x(i)} y={BY} width={BW} height={BH} rx="4" />
          <text class="num" x={x(i) + 10} y={BY + 16}>P{i + 1}</text>
          {ls.map((l, j) => <text class="name" x={cx(i)} y={top + j * 15} text-anchor="middle">{l}</text>)}
        </g>
      );
    })}

    <!-- forward flow + gates -->
    {phases.slice(0, -1).map((_, i) => {
      const gx = x(i) + BW + GAP / 2;
      const gy = BY + BH / 2;
      return (
        <g>
          <line class="flow" x1={x(i) + BW} y1={gy} x2={x(i + 1) - 3} y2={gy} marker-end="url(#ps-arrow)" />
          <path class="gate" d={`M${gx} ${gy - 6}l6 6-6 6-6-6z`} />
        </g>
      );
    })}
    <text class="gate-label" x={x(0) + BW + GAP / 2} y={BY + BH + 16} text-anchor="middle">◆ {t.gate}</text>

    <!-- loop-backs out of Maintenance -->
    {loopBacks.map((lb, k) => {
      const y = BY + BH + 34 + k * 34;
      const from = cx(maint) - 28 + k * 28;
      const to = cx(idx[lb.to]);
      return (
        <g class="loop">
          <path d={`M${from} ${BY + BH} V${y - 6} q0 6 -6 6 H${to + 6} q-6 0 -6 -6 V${BY + BH + 4}`} marker-end="url(#ps-arrow-pen)" />
          <text x={(from + to) / 2} y={y - 5} text-anchor="middle">{lb.label[lang]}</text>
        </g>
      );
    })}
  </svg>
</div>

<style>
  .strip-scroll {
    overflow-x: auto;
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
    scrollbar-width: thin;
  }
  .phase-strip { width: 100%; min-width: 760px; height: auto; overflow: visible; }
  .spec-band { fill: var(--pen-soft); stroke: var(--pen); stroke-width: 1; }
  .spec-text { font-family: var(--font-mono); font-size: 11.5px; letter-spacing: 0.04em; fill: var(--ink); }
  .anchor { stroke: var(--pen); stroke-width: 1; stroke-dasharray: 2 3; }
  .sa { fill: none; stroke: var(--rule-strong); stroke-dasharray: 4 3; }
  .sa-text { font-family: var(--font-body); font-size: 12px; fill: var(--ink-2); }
  .phase rect { fill: var(--surface); stroke: var(--ink); stroke-width: 1.2; }
  .phase.last rect { fill: var(--surface-2); }
  .num { font-family: var(--font-mono); font-size: 10px; fill: var(--pen); letter-spacing: 0.04em; }
  .name { font-family: var(--font-body); font-weight: 500; font-size: 13px; fill: var(--ink); }
  .flow { stroke: var(--ink-2); stroke-width: 1.2; }
  .arrowhead { fill: var(--ink-2); }
  .arrowhead-pen { fill: var(--pen); }
  .gate { fill: var(--bg); stroke: var(--pen); stroke-width: 1.4; }
  .gate-label { font-family: var(--font-mono); font-size: 10.5px; fill: var(--muted); }
  .loop path { fill: none; stroke: var(--pen); stroke-width: 1.2; stroke-dasharray: 5 4; }
  .loop text { font-family: var(--font-mono); font-size: 11px; font-style: italic; fill: var(--ink-2); paint-order: stroke; stroke: var(--bg); stroke-width: 5px; }
</style>
