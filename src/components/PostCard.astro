---
import TagChip from './TagChip.astro';
interface Props {
  href: string;
  title: string;
  description: string;
  date: string;
  datetime: string;
  readingTime: string;
  tags?: { label: string; href: string }[];
  pinned?: boolean;
  pinnedLabel?: string;
  draft?: boolean;
  draftLabel?: string;
}
const { href, title, description, date, datetime, readingTime, tags = [], pinned = false, pinnedLabel = 'Pinned page', draft = false, draftLabel = 'Draft' } = Astro.props;
---
<article class:list={['post', { pinned }]} data-reveal>
  {pinned && (
    <p class="pin kicker">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.5 3.5l6 6-3 1-3.5 3.5.5 4-1.5 1.5-4-4-4.5 4.5M8.5 13.5l-4-4L6 8l4 .5L13.5 5z" /></svg>
      {pinnedLabel}
    </p>
  )}
  <p class="meta post-meta">
    <time datetime={datetime}>{date}</time> · <span class="upper">{readingTime}</span>
    {draft && <span class="draft">{draftLabel}</span>}
  </p>
  <h3 class="post-title"><a href={href} class="post-link">{title}</a></h3>
  <p class="desc">{description}</p>
  {tags.length > 0 && (
    <ul class="tags" role="list">
      {tags.map((t) => <li><TagChip label={`#${t.label}`} href={t.href} /></li>)}
    </ul>
  )}
</article>
<style>
  .post {
    position: relative;
    display: grid;
    gap: var(--s-2);
    padding: var(--s-5) 0;
    border-bottom: 1px solid var(--rule);
  }
  .post-title { font-size: var(--step-2); }
  .post-link { text-decoration: none; }
  .post-link::after { content: ''; position: absolute; inset: 0; }
  .post:hover .post-title { text-decoration: underline; text-decoration-color: var(--pen); text-decoration-thickness: 1.5px; text-underline-offset: 0.18em; }
  .desc { color: var(--ink-2); max-width: 62ch; }
  .tags { display: flex; flex-wrap: wrap; gap: var(--s-2); padding: 0; margin-top: var(--s-2); list-style: none; position: relative; z-index: 1; }
  .draft {
    margin-left: var(--s-2);
    padding: 0 0.4em;
    border: 1.5px solid var(--pen);
    color: var(--pen);
    font-weight: 500;
    text-transform: uppercase;
    transform: rotate(-3deg);
    display: inline-block;
  }
  .pinned {
    padding: var(--s-6);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .pinned .post-title { font-size: var(--step-3); }
  .pin { display: inline-flex; align-items: center; gap: 0.5em; color: var(--pen); }
  .pin svg { width: 16px; height: 16px; fill: none; stroke: var(--pen); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; transform: rotate(-12deg); }
</style>
