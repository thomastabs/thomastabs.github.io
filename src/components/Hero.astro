---
import JourneyGraph from './JourneyGraph.astro';
import { useTranslations, type Locale } from '@/i18n';
import { localePath } from '@/i18n/routes';
import { profile } from '@/data/links';

interface Props { lang: Locale; headingLevel?: 'h1' | 'p'; localAnchors?: string[] }
const { lang, headingLevel = 'h1', localAnchors } = Astro.props;
const t = useTranslations(lang);
const Name = headingLevel;
---
<section class="hero dot-grid" aria-labelledby="hero-name">
  <div class="container hero-grid">
    <div class="hero-copy">
      <Name id="hero-name" class="hero-name">
        Tomás Taborda
      </Name>
      <p class="status">{t('hero.status')}</p>
      <p class="positioning">{t('hero.positioning')}</p>
      <div class="btn-set">
        <a class="btn btn--primary" href={localePath('work', lang)}>{t('cta.viewWork')}</a>
        <a class="btn" href={localePath('work', lang, 'apex')}>{t('cta.readThesis')}</a>
        <a class="btn hero-cv" href={profile.cv} download>{t('nav.cv')}</a>
      </div>
    </div>
    <div class="hero-graph">
      <JourneyGraph lang={lang} localAnchors={localAnchors} />
    </div>
  </div>
</section>

<style>
  /* Dusk wash: the same violet-to-red sky as the contact photo, so the page opens and
     closes in one light. Light mode keeps only a trace of it, because the same wash turns pink on pale paper. The violet is a faint corner accent; red carries the wash. */
  .hero {
    --dusk: 3.5%;
    --dusk-band: 0;
    --dusk-violet: #6b2fa0;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-bottom: 1px solid var(--rule);
    padding-block: var(--s-8) var(--s-7);
  }
  @media (min-width: 960px) { .hero { padding-block: var(--s-9) var(--s-8); } }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(ellipse 60% 75% at 78% 105%, color-mix(in srgb, var(--pen) calc(var(--dusk) * 1.7), transparent), transparent 70%),
      radial-gradient(ellipse 35% 40% at 100% 0%, color-mix(in srgb, var(--dusk-violet) calc(var(--dusk) * 0.5), transparent), transparent 70%),
      linear-gradient(to bottom, transparent 55%, color-mix(in srgb, var(--pen) calc(var(--dusk) * var(--dusk-band)), transparent));
  }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme='light'])) .hero { --dusk: 24%; --dusk-band: 0.6; --dusk-violet: #8a3fd0; } }
  :global(:root[data-theme='dark']) .hero { --dusk: 24%; --dusk-band: 0.6; --dusk-violet: #8a3fd0; }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-7);
    align-items: center;
  }
  @media (min-width: 960px) {
    .hero-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 540px); gap: var(--s-6); }
  }
  .hero-graph { width: 100%; max-width: 540px; }
  .hero-copy > * + * { margin-top: var(--s-3); }
  /* The header holds the CV link on wide screens; the phone menu hides it. */
  .hero-cv { display: none; }
  @media (max-width: 760px) { .hero-cv { display: inline-flex; min-width: 24px; justify-content: center; } }
  .hero-name {
    margin-top: var(--s-2);
    font-family: var(--font-display);
    font-size: var(--t-40);
    font-weight: 500;
    line-height: 1.1;
    font-variation-settings: 'opsz' 144;
    color: var(--ink);
  }
  @media (min-width: 720px) { .hero-name { font-size: var(--t-56); } }
  /* Two lines at desktop: the copy column is ~650px, so the line runs at the 17px body size. */
  .positioning {
    font-size: var(--t-17);
    line-height: 1.6;
    color: var(--ink-2);
    max-width: 44rem;
  }
  @media (max-width: 959px) { .positioning { font-size: var(--t-20); line-height: 1.5; } }
  .status { color: var(--ink); font-size: var(--t-16); }
  .btn-set { margin-top: var(--s-5); }
</style>
