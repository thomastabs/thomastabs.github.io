---
interface Props { href: string; label: string }
const { href, label } = Astro.props;
---
<a class="wordmark" href={href} aria-label={label}>
  <span aria-hidden="true"><span class="pen">T</span>omás <span class="pen">T</span>aborda</span>
</a>
<style>
  .wordmark {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    text-decoration: none;
    color: var(--ink);
    white-space: nowrap;
    font-variation-settings: 'opsz' 36;
  }
</style>
