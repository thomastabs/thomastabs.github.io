---
import SeriesPage from '@/views/SeriesPage.astro';
import { getPosts } from '@/lib/notebook';

export async function getStaticPaths() {
  const names = new Set((await getPosts('en')).flatMap((p) => (p.data.series ? [p.data.series] : [])));
  return [...names].map((series) => ({ params: { series } }));
}
const { series } = Astro.params as { series: string };
---
<SeriesPage lang="en" series={series} />
