  .exports dt { font-family: var(--font-mono); font-size: var(--step--2); text-transform: uppercase; letter-spacing: var(--tracking-mono); color: var(--muted); }
  .exports dd { margin: var(--s-1) 0 0; font-family: var(--font-mono); font-size: var(--step-2); color: var(--ink); }

  .muted-note { font-style: italic; }
