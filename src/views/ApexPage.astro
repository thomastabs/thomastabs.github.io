  .findings h3 { font-size: var(--step-1); margin-bottom: var(--s-2); }
  .findings p { color: var(--ink-2); }

  .ledger-card { display: block; max-width: 46rem; padding: var(--s-6); border: 1px solid var(--rule-strong); border-radius: var(--radius); background: var(--surface); text-decoration: none; transition: border-color var(--dur) var(--ease); }
  .ledger-card:hover { border-color: var(--ink); }
  .ledger-card { margin-top: var(--s-7); }
  .ledger-card h3 { font-size: var(--step-2); margin-top: var(--s-2); }
  .gallery--3 { grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr)); }
  .walk-h { padding-top: var(--s-7); }
  .compare { margin-bottom: var(--s-6); }
  .compare :global(.fig-tall) { max-height: 34rem; object-fit: contain; }
  .hist-cols { margin-top: var(--s-6); }
  .tax { margin: 0; display: grid; gap: var(--s-2); }
  .tax div { display: grid; grid-template-columns: 5.5rem 1fr; align-items: center; gap: var(--s-3); }
  .tax dt { font-size: var(--step--1); color: var(--ink-2); }
  .tax dd { margin: 0; display: flex; align-items: center; gap: var(--s-2); }
  .tax-bar { display: block; height: 10px; width: var(--w); background: var(--pen); border-radius: 2px; opacity: 0.85; }
  .tax-v { font-size: var(--step--1); color: var(--ink); }
  .tl-filters { display: flex; flex-wrap: wrap; margin-bottom: var(--s-4); border-bottom: 1px solid var(--rule-strong); }
  :global(.js) .tl-filters[hidden] { display: flex; }
  .tab { display: inline-flex; align-items: center; gap: 0.45em; margin-bottom: -1px; padding: 0.55rem 0.9rem; min-height: 44px; border: 1px solid transparent; border-bottom-color: var(--rule-strong); border-radius: var(--radius-sm) var(--radius-sm) 0 0; background: transparent; color: var(--ink-2); font-family: var(--font-mono); font-size: var(--step--1); letter-spacing: var(--tracking-mono); cursor: pointer; }
