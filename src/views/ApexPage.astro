  .stats { display: flex; flex-wrap: wrap; gap: 0; padding: 0; list-style: none; border-top: 1px solid var(--rule-strong); border-bottom: 1px solid var(--rule-strong); }
  .stats li { flex: 1 1 9rem; padding: var(--s-4) var(--s-4) var(--s-4) 0; display: grid; gap: var(--s-1); }
  .stats li + li { padding-left: var(--s-4); border-left: 1px solid var(--rule); }
  .stat-v { font-family: var(--font-mono); font-size: var(--step-2); color: var(--ink); }
  .stat-l { font-family: var(--font-mono); font-size: var(--step--2); text-transform: uppercase; letter-spacing: var(--tracking-mono); color: var(--muted); }

  .exports { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); gap: var(--s-4); margin: 0; }
