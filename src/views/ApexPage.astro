  .bib :global(pre) { white-space: pre-wrap; word-break: break-word; }
</style>

<script>
  /* Timeline filter. Without JS the tabs stay hidden and every entry shows. */
  const bar = document.querySelector<HTMLElement>('[data-tl-filters]');
  const list = document.querySelector<HTMLElement>('[data-tl]');
  if (bar && list) {
    bar.hidden = false;
    bar.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-f]');
      if (!btn) return;
      const f = btn.dataset.f;
      bar.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      list.querySelectorAll<HTMLElement>('li').forEach((li) => { li.hidden = f !== 'all' && li.dataset.tag !== f; });
    });
  }
</script>
