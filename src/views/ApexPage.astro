  .block > h2 { margin-top: var(--s-3); max-width: 24ch; }
  .prose-p { max-width: var(--measure); color: var(--ink-2); }

  .full-abstract { max-width: var(--measure); border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
