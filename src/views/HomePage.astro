---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import SpecBlock from '@/components/SpecBlock.astro';
import TimelineEntry from '@/components/TimelineEntry.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import PhaseStrip from '@/components/PhaseStrip.astro';
import PostCard from '@/components/PostCard.astro';
import ContactSection from '@/components/ContactSection.astro';
import portrait from '@/assets/portrait/portrait.jpg';
import { useTranslations, type Locale } from '@/i18n';
import { localePath } from '@/i18n/routes';
import { about } from '@/data/about';
import { skills } from '@/data/skills';
import { phases } from '@/data/apex';
import { experience } from '@/data/experience';
import { education } from '@/data/education';
import { profile } from '@/data/links';
import { getWork, cardProps } from '@/lib/work';
import { getPosts, cardProps as postCardProps, indexHref } from '@/lib/notebook';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);

const roles = experience.filter((e) => e.kind !== 'community');
const { featured } = await getWork();
const [apex, ...rest] = featured;
const others = rest.slice(0, 3);
const apexCard = apex ? cardProps(apex, lang) : undefined;
const latest = (await getPosts(lang)).slice(0, 3);

const localAnchors = [...roles.map((r) => r.id), ...education.map((e) => e.id), 'contact'];

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Tomás Taborda',
  jobTitle: lang === 'pt' ? 'Engenheiro de Software' : 'Software Engineer',
  url: 'https://tomastaborda.com/',
  email: `mailto:${profile.email}`,
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Instituto Superior Técnico', url: 'https://tecnico.ulisboa.pt/' },
  sameAs: [profile.github, profile.linkedin],
};
---

<BaseLayout lang={lang} title={t('home.title')}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(personLd)} />

  <Hero lang={lang} localAnchors={localAnchors} />

  <section class="container section" id="about" aria-labelledby="about-title">
    <SectionHeading n={1} label={t('section.about')} id="about-title" />
    <div class="about-grid">
      <div class="about-text">
        {about.map((p) => <p>{p[lang]}</p>)}
        <details class="skills" open>
          <summary>{t('about.skills')}</summary>
          <SpecBlock
            title={t('about.skills')}
            compact
            rows={skills.map((g) => ({ k: g.group[lang], v: g.items.map((i) => i.replaceAll(' ', ' ')).join(', ') }))}
          />
        </details>
        <script is:inline>if (matchMedia('(max-width: 760px)').matches) document.currentScript.previousElementSibling.open = false;</script>
      </div>
      <Image class="portrait-img" src={portrait} alt={t('about.portrait')} widths={[300, 460, 600]} sizes="(min-width: 900px) 272px, 224px" />
    </div>
  </section>

  <section class="container section-tight" id="work" aria-labelledby="work-title">
    <SectionHeading n={4} label={t('section.selectedWork')} id="work-title" />
    <div class="work-grid">
      {apexCard && (
        <article class="apex-feature">
          <h3 class="apex-feature-title"><a href={apexCard.href}>{apexCard.title}</a></h3>
          <p class="meta">{apexCard.kicker}, {apexCard.year}</p>
          <p class="apex-feature-summary">{apexCard.summary}</p>
          <div class="apex-diagram"><PhaseStrip lang={lang} /></div>
          <ol class="phase-list" role="list">
            {phases.map((p) => <li>{p.name[lang]}</li>)}
          </ol>
          <div class="apex-feature-links">
            {apexCard.links?.map((l) => <a class="pen-link" href={l.href}>{l.label}{l.href.startsWith('http') ? <span class="ext" aria-hidden="true"></span> : ''}</a>)}
          </div>
        </article>
      )}
      <div class="work-row">
        {others.map((e) => <ProjectCard maxStack={4} {...cardProps(e, lang)} />)}
      </div>
    </div>
    <a class="pen-link more" href={localePath('work', lang)}>{t('cta.allWork')}</a>
  </section>

  <section class="container section-tight" id="experience" aria-labelledby="exp-title">
    <SectionHeading n={2} label={t('section.experience')} id="exp-title" />
    <ol class="timeline" role="list">
      {roles.map((r) => (
        <TimelineEntry
          id={r.id}
          period={r.period[lang]}
          title={r.role[lang]}
          org={r.org[lang]}
          logo={r.logo}
          monogram={r.monogram}
        >
          {r.summary && <p>{r.summary[lang]}</p>}
        </TimelineEntry>
      ))}
    </ol>
    <a class="pen-link more" href={localePath('journey', lang)}>{t('cta.fullJourney')}</a>
  </section>

  <section class="container section-tight" id="education" aria-labelledby="edu-title">
    <SectionHeading n={3} label={t('section.education')} id="edu-title" />
    <ol class="timeline" role="list">
      {education.map((e) => (
        <TimelineEntry
          id={e.id}
          period={e.period[lang]}
          title={e.degree[lang]}
          org={`${e.institution}${e.location ? `, ${e.location[lang]}` : ''}`}
          logo={e.logo}
          monogram={e.monogram}
        >
          {e.details && <p>{e.details[lang]}</p>}
          {e.thesis && (
            <p class="edu-details">
              {t('education.thesis')}: <em>{e.thesis.title}</em>. {t('education.advisor')}: {e.thesis.advisor}. {t('education.defendedOn')} {e.thesis.defended[lang]}, {e.thesis.grade}.{' '}
              <a class="pen-link" href={localePath('work', lang, 'apex')}>{t('education.caseStudy')}</a>
            </p>
          )}
          {e.coursework && (
            <details class="coursework">
              <summary>{t('education.coursework')}</summary>
              <p>{e.coursework.map((c) => c[lang]).join(', ')}.</p>
            </details>
          )}
        </TimelineEntry>
      ))}
    </ol>
  </section>

  {latest.length > 0 && (
    <>
      <section class="container section-tight" id="notebook" aria-labelledby="notebook-title">
        <SectionHeading n={5} label={t('section.fromNotebook')} id="notebook-title" />
        <div class="notes">
          {latest.map((p) => <PostCard {...postCardProps(p, t)} />)}
        </div>
        <a class="pen-link more" href={indexHref(lang)}>{t('notebook.allNotes')}</a>
      </section>
    </>
  )}

  <ContactSection lang={lang} />
</BaseLayout>

<style>
  .section-tight { padding-top: var(--section-gap); }
  :global(.contact) { margin-top: var(--s-7); }

  .about-grid { display: grid; gap: var(--s-6); align-items: start; }
  @media (min-width: 900px) { .about-grid { grid-template-columns: minmax(0, 1fr) 17rem; gap: var(--s-8); } }
  .about-text > p { max-width: var(--measure); }
  .about-text > * + * { margin-top: var(--s-3); }
  .about-text > :global(.spec) { margin-top: var(--s-6); }
  :global(.portrait-img) {
    width: 100%; max-width: 17rem; height: auto;
    aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 12%;
    border: 1px solid var(--rule); border-radius: var(--radius);
  }
  @media (max-width: 899px) { :global(.portrait-img) { order: -1; max-width: 14rem; } }


  .timeline { padding: 0; }
  .more { display: inline-block; margin-top: var(--s-3); font-size: var(--t-16); }

  .edu-details { margin-top: var(--s-2); }
  .coursework { margin-top: var(--s-2); color: var(--ink-2); max-width: var(--measure); }
  .skills summary { display: none; }
  @media (max-width: 760px) {
    .skills summary { display: flex; align-items: center; gap: var(--s-2); min-height: 44px; cursor: pointer; font-size: var(--t-16); font-weight: 500; }
    .skills summary::-webkit-details-marker { display: none; }
    .skills summary::before { content: '+'; width: 1ch; color: var(--muted); }
    .skills[open] summary::before { content: '−'; }
    .skills :global(.spec-title) { display: none; }
  }
  .coursework summary { cursor: pointer; min-height: 44px; display: flex; align-items: center; gap: var(--s-2); color: var(--ink); list-style: none; }
  .coursework summary::-webkit-details-marker { display: none; }
  .coursework summary::before { content: '+'; color: var(--muted); width: 1ch; }
  .coursework[open] summary::before { content: '−'; }

  .work-grid { display: grid; gap: var(--s-5); margin-bottom: var(--s-5); }
  /* Apex is the one loud thing on the page: its phase and gate diagram, full width. */
  .apex-feature { display: grid; gap: var(--s-3); padding: var(--s-6); border: 1px solid var(--rule-strong); border-radius: var(--radius); background: var(--surface); }
  .apex-feature-title { font-size: var(--t-40); line-height: 1.1; }
  .apex-feature-title a { text-decoration: none; }
  .apex-feature-title a:hover { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.15em; }
  .apex-feature-summary { font-size: var(--t-17); color: var(--ink-2); max-width: var(--measure); }
  .apex-diagram { display: none; margin-block: var(--s-5) var(--s-3); }
  .apex-diagram :global(.strip-scroll) { overflow: visible; margin: 0; padding: 0; }
  .apex-diagram :global(.phase-strip) { min-width: 0; }
  .phase-list { display: grid; gap: var(--s-1); margin: var(--s-2) 0; padding: 0; list-style: none; counter-reset: phase; }
  .phase-list li { counter-increment: phase; display: flex; gap: var(--s-2); padding-block: var(--s-1); border-top: 1px solid var(--rule); }
  .phase-list li::before { content: 'P' counter(phase); width: 2rem; flex: none; font-family: var(--font-mono); font-size: var(--t-14); line-height: 1.7; color: var(--muted); }
  .apex-feature-links { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-5); padding-top: var(--s-3); border-top: 1px solid var(--rule); font-size: var(--t-16); }
  @media (min-width: 761px) {
    .apex-diagram { display: block; }
    .phase-list { display: none; }
  }
  .work-row { display: grid; gap: var(--s-5); grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); }
</style>
