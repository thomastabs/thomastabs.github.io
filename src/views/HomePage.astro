---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import SpecBlock from '@/components/SpecBlock.astro';
import TimelineEntry from '@/components/TimelineEntry.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import PostCard from '@/components/PostCard.astro';
import ContactSection from '@/components/ContactSection.astro';
import portrait from '@/assets/portrait/portrait.jpg';
import { useTranslations, type Locale } from '@/i18n';
import { localePath } from '@/i18n/routes';
import { about } from '@/data/about';
import { skills } from '@/data/skills';
import { experience } from '@/data/experience';
import { education } from '@/data/education';
import { profile } from '@/data/links';
import { getWork, cardProps } from '@/lib/work';
import { getPosts, cardProps as postCardProps, indexHref } from '@/lib/notebook';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);

const roles = experience.filter((e) => e.kind !== 'community');
const { featured } = await getWork();
const [apex, ...rest] = featured;
const others = rest.slice(0, 3);
const latest = (await getPosts(lang)).slice(0, 3);

const localAnchors = [...roles.map((r) => r.id), ...education.map((e) => e.id), 'contact'];

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Tomás Taborda',
  jobTitle: lang === 'pt' ? 'Engenheiro de Software' : 'Software Engineer',
  url: 'https://tomastaborda.com/',
  email: `mailto:${profile.email}`,
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Instituto Superior Técnico', url: 'https://tecnico.ulisboa.pt/' },
  sameAs: [profile.github, profile.linkedin],
};
---

<BaseLayout lang={lang} title={t('home.title')}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(personLd)} />

  <Hero lang={lang} localAnchors={localAnchors} />

  <section class="container section" id="about" aria-labelledby="about-title">
    <SectionHeading n={1} label={t('section.about')} id="about-title" />
    <div class="about-grid">
      <div class="about-text">
        {about.map((p) => <p>{p[lang]}</p>)}
        <SpecBlock
          title={t('about.skills')}
          compact
          rows={skills.map((g) => ({ k: g.group[lang], v: g.items.join(' · '), mono: true }))}
        />
      </div>
      <Image class="portrait-img" src={portrait} alt={t('about.portrait')} widths={[300, 460, 600]} sizes="(min-width: 900px) 272px, 224px" />
    </div>
  </section>

  <section class="container section-tight" id="experience" aria-labelledby="exp-title">
    <SectionHeading n={2} label={t('section.experience')} id="exp-title" />
    <ul class="roles" role="list">
      {roles.map((r) => (
        <li id={r.id} class="role">
          <span class="role-name">{r.role[lang]}</span>
          <span class="role-org">{r.org[lang]}</span>
          <span class="date">{r.period[lang]}</span>
        </li>
      ))}
    </ul>
    <a class="pen-link more" href={localePath('journey', lang)}>{t('cta.fullJourney')} →</a>
  </section>

  <section class="container section-tight" id="education" aria-labelledby="edu-title">
    <SectionHeading n={3} label={t('section.education')} id="edu-title" />
    <ol class="timeline" role="list">
      {education.map((e) => (
        <TimelineEntry
          id={e.id}
          period={e.period[lang]}
          title={e.degree[lang]}
          org={`${e.institution}${e.location ? ` · ${e.location[lang]}` : ''}`}
          logo={e.logo}
          monogram={e.monogram}
        >
          {e.details && <p>{e.details[lang]}</p>}
          {e.thesis && (
            <p class="edu-details">
              {t('education.thesis')}: <em>{e.thesis.title}</em>. {t('education.advisor')}: {e.thesis.advisor}. {t('education.defendedOn')} {e.thesis.defended[lang]}, {e.thesis.grade}.{' '}
              <a class="pen-link" href={localePath('work', lang, 'apex')}>{t('education.caseStudy')} →</a>
            </p>
          )}
          {e.coursework && (
            <p class="coursework"><span class="cw-label">{t('education.coursework')}:</span> {e.coursework.map((c) => c[lang]).join(', ')}.</p>
          )}
        </TimelineEntry>
      ))}
    </ol>
  </section>

  <section class="container section-tight" id="work" aria-labelledby="work-title">
    <SectionHeading n={4} label={t('section.selectedWork')} id="work-title" />
    <div class="work-grid">
      {apex && <ProjectCard featured maxStack={4} {...cardProps(apex, lang)} />}
      <div class="work-row">
        {others.map((e) => <ProjectCard maxStack={4} {...cardProps(e, lang)} />)}
      </div>
    </div>
    <a class="pen-link more" href={localePath('work', lang)}>{t('cta.allWork')} →</a>
  </section>

  {latest.length > 0 && (
    <>
      <section class="container section-tight" id="notebook" aria-labelledby="notebook-title">
        <SectionHeading n={5} label={t('section.fromNotebook')} id="notebook-title" />
        <div class="notes">
          {latest.map((p) => <PostCard {...postCardProps(p, t)} />)}
        </div>
        <a class="pen-link more" href={indexHref(lang)}>{t('notebook.allNotes')} →</a>
      </section>
    </>
  )}

  <ContactSection lang={lang} />
</BaseLayout>

<style>
  .section-tight { padding-top: var(--section-gap); }
  :global(.contact) { margin-top: var(--s-7); }

  .about-grid { display: grid; gap: var(--s-6); align-items: start; }
  @media (min-width: 900px) { .about-grid { grid-template-columns: minmax(0, 1fr) 17rem; gap: var(--s-8); } }
  .about-text > p { max-width: var(--measure); }
  .about-text > * + * { margin-top: var(--s-3); }
  .about-text > :global(.spec) { margin-top: var(--s-6); }
  :global(.portrait-img) {
    width: 100%; max-width: 17rem; height: auto;
    aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 12%;
    border: 1px solid var(--rule); border-radius: var(--radius);
  }
  @media (max-width: 899px) { :global(.portrait-img) { order: -1; max-width: 14rem; } }

  .roles { list-style: none; padding: 0; margin: 0; }
  .role {
    display: grid; gap: 0 var(--s-3);
    padding: var(--s-3) 0; border-bottom: 1px solid var(--rule);
  }
  .role:first-child { padding-top: 0; }
  @media (min-width: 720px) {
    .role { grid-template-columns: minmax(0, 2fr) minmax(0, 2fr) minmax(0, 1fr); align-items: baseline; }
    .role .date { text-align: right; }
  }
  .role-name { font-weight: 500; color: var(--ink); }
  .role-org { color: var(--ink-2); }

  .timeline { padding: 0; }
  .more { display: inline-block; margin-top: var(--s-3); font-size: var(--t-16); }

  .edu-details { margin-top: var(--s-2); }
  .coursework { margin-top: var(--s-2); color: var(--ink-2); max-width: var(--measure); }
  .cw-label { color: var(--ink); }

  .work-grid { display: grid; gap: var(--s-5); margin-bottom: var(--s-5); }
  .work-row { display: grid; gap: var(--s-5); grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); }
</style>
