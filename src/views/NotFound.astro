---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { useTranslations } from '@/i18n';
import { localePath } from '@/i18n/routes';

const en = useTranslations('en');
const pt = useTranslations('pt');
---
<BaseLayout lang="en" title="404" noindex altHref="/pt/">
  <div class="container torn-wrap">
    <div class="page">
      <svg class="tear" viewBox="0 0 600 28" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 28V12l14 6 11-9 13 8 9-11 15 10 10-7 14 9 12-10 9 6 16-8 8 10 13-9 12 8 10-11 14 9 9-5 15 9 11-10 12 7 10-6 16 10 8-9 13 7 11-10 15 9 9-6 12 8 14-10 9 8 13-7 10 9 15-10 8 6 12-8 14 10 9-9 13 7 10-6 16 9 8-10 13 8 12-6 9 9 15-10 10 7 13-8 11 9 12-7 14 8 9-10 13 9 10-6 15 8 8-9 13 9V28Z" />
      </svg>
      <p class="kicker"><span class="pen">§404</span> — not found · página não encontrada</p>
      <h1>{en('404.title')}</h1>
      <p class="lead">{en('404.lead')}</p>
      <p class="pt" lang="pt-PT">{pt('404.title')}. {pt('404.lead')}</p>
      <p class="meta upper try">{en('404.tryThese')} · <span lang="pt-PT">{pt('404.tryThese')}</span></p>
      <ul class="btn-set" role="list">
        <li><a class="btn btn--primary" href="/">{en('404.home')}</a></li>
        <li><a class="btn" href={localePath('work', 'en')}>{en('nav.work')}</a></li>
        <li><a class="btn" href={localePath('journey', 'en')}>{en('nav.journey')}</a></li>
        <li><a class="btn" href="/pt/" lang="pt-PT">{pt('404.home')} (PT)</a></li>
      </ul>
    </div>
  </div>
</BaseLayout>
<style>
  .torn-wrap { padding-block: clamp(3rem, 2rem + 6vw, 7rem); }
  .page {
    position: relative; max-width: 44rem; padding: var(--s-8) var(--s-6) var(--s-6);
    background:
      repeating-linear-gradient(to bottom, transparent 0 31px, var(--rule) 31px 32px),
      var(--surface);
    border: 1px solid var(--rule-strong); border-top: 0;
    transform: rotate(-0.6deg);
  }
  .page::before { content: ''; position: absolute; top: 0; bottom: 0; left: 2.25rem; width: 1px; background: var(--pen-soft); }
  .tear { position: absolute; left: -1px; right: -1px; top: -27px; width: calc(100% + 2px); height: 28px; max-width: none; }
  .tear path { fill: var(--surface); stroke: var(--rule-strong); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .page > * + * { margin-top: var(--s-4); }
  h1 { font-size: var(--step-4); }
  .pt { color: var(--muted); font-style: italic; }
  .try { padding-top: var(--s-4); }
  .btn-set { padding: 0; list-style: none; }
</style>
