---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { useTranslations } from '@/i18n';
import { localePath } from '@/i18n/routes';

const en = useTranslations('en');
const pt = useTranslations('pt');
---
<BaseLayout lang="en" title={en('404.title')} noindex altHref="/pt/">
  <div class="container nf">
    <h1>{en('404.title')}</h1>
    <p class="lead">{en('404.lead')}</p>
    <p class="pt" lang="pt-PT">{pt('404.title')}. {pt('404.lead')}</p>
    <p class="try">{en('404.tryThese')} · <span lang="pt-PT">{pt('404.tryThese')}</span></p>
    <ul class="btn-set" role="list">
      <li><a class="btn btn--primary" href="/">{en('404.home')}</a></li>
      <li><a class="btn" href={localePath('work', 'en')}>{en('nav.work')}</a></li>
      <li><a class="btn" href={localePath('journey', 'en')}>{en('nav.journey')}</a></li>
      <li><a class="btn" href={localePath('notebook', 'en')}>{en('nav.notebook')}</a></li>
      <li><a class="btn" href={localePath('contact', 'en')}>{en('nav.contact')}</a></li>
      <li><a class="btn" href="/pt/" lang="pt-PT">{pt('404.home')} (PT)</a></li>
    </ul>
  </div>
</BaseLayout>
<style>
  .nf { padding-block: var(--s-9); }
  .nf > * + * { margin-top: var(--s-3); }
  .pt { color: var(--muted); }
  .try { padding-top: var(--s-3); color: var(--ink-2); }
  .btn-set { padding: 0; list-style: none; }
</style>
