---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import type { LogoKey } from '@/lib/logos';
import TimelineEntry from '@/components/TimelineEntry.astro';
import { useTranslations, type Locale } from '@/i18n';
import { localePath } from '@/i18n/routes';
import { experience } from '@/data/experience';
import { education, milestones } from '@/data/education';
import type { Kind } from '@/data/types';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);

interface Item {
  id: string; key: string; kind: Kind; period: string; title: string; org?: string; summary?: string;
  stack?: string[]; notesHref?: string; extraHref?: { href: string; label: string };
  logo?: LogoKey; monogram?: string;
}

/** Milestones with a Notebook post, per locale. */
const milestoneNotes: Record<string, string> = lang === 'pt'
  ? { 'ms-defence': `${localePath('notebook', lang, 'defender-o-apex')}/`, 'ms-opensoft': `${localePath('notebook', lang, 'da-tese-a-opensoft')}/` }
  : { 'ms-defence': `${localePath('notebook', lang, 'defending-apex')}/`, 'ms-opensoft': `${localePath('notebook', lang, 'job-hunting-with-an-ai')}/` };

const items: Item[] = [
  ...experience.map((e) => ({
    id: e.id, key: e.start, kind: e.kind, period: e.period[lang], title: e.role[lang], org: e.org[lang],
    summary: e.summary[lang], stack: e.stack, notesHref: e.notesSlug ? localePath('notebook', lang, e.notesSlug) : undefined,
    logo: e.logo, monogram: e.monogram,
  })),
  ...education.map((e) => ({
    id: e.id, key: e.start, kind: 'study' as Kind, period: e.period[lang], title: e.degree[lang], org: e.location ? `${e.institution} · ${e.location[lang]}` : e.institution,
    summary: [e.details?.[lang], e.thesis ? `${t('education.thesis')}: ${e.thesis.title}.` : undefined, e.coursework ? `${t('education.coursework')}: ${e.coursework.map((c) => c[lang]).join(', ')}.` : undefined].filter(Boolean).join(' ') || undefined,
    extraHref: e.thesis ? { href: localePath('work', lang, 'apex'), label: t('education.caseStudy') } : undefined,
    logo: e.logo, monogram: e.monogram,
  })),
  ...milestones.map((m) => ({
    id: m.id, key: m.date, kind: 'milestone' as Kind, period: m.period[lang], title: m.title[lang], summary: m.details?.[lang],
    notesHref: milestoneNotes[m.id],
    extraHref: m.id === 'ms-defence' ? { href: localePath('work', lang, 'apex'), label: t('education.caseStudy') } : undefined,
  })),
].sort((a, b) => b.key.localeCompare(a.key));

const kinds: Kind[] = ['work', 'study', 'teaching', 'community', 'milestone'];
const counts = Object.fromEntries(kinds.map((k) => [k, items.filter((i) => i.kind === k).length]));
---

<BaseLayout lang={lang} title={t('journey.metaTitle')} description={t('journey.description')}>
  <div class="container page-head">
    <SectionHeading n="02" label={t('nav.journey')} title={t('journey.title')} level="h1">
      <p class="lead intro">{t('journey.intro')}</p>
    </SectionHeading>

    <div class="filters filter-pills" role="group" aria-label={t('journey.filter')} data-filters hidden>
      <button type="button" class="filter-pill" aria-pressed="true" data-filter="all">{t('journey.all')} <span class="count">{items.length}</span></button>
      {kinds.map((k) => (
        <button type="button" class="filter-pill" aria-pressed="false" data-filter={k}>
          {t(`tag.${k}` as const)} <span class="count">{counts[k]}</span>
        </button>
      ))}
    </div>
  </div>

  <div class="container">
    <ol class="timeline" role="list" data-timeline>
      {items.map((i) => (
        <TimelineEntry
          id={i.id}
          headingLevel="h2"
          period={i.period}
          title={i.title}
          org={i.org}
          tags={[{ kind: i.kind, label: t(`tag.${i.kind}` as const) }]}
          stack={i.stack}
          logo={i.logo}
          monogram={i.monogram}
          notesHref={i.notesHref ?? i.extraHref?.href}
          notesLabel={i.notesHref ? t('cta.readNotes') : i.extraHref?.label}
        >
          {i.summary && <p>{i.summary}</p>}
        </TimelineEntry>
      ))}
    </ol>
    <p class="sr-only" aria-live="polite" data-filter-status></p>
  </div>
</BaseLayout>

<style>
  .page-head { padding-top: var(--s-8); }
  .intro { margin-top: var(--s-3); }
  .filters { margin-top: var(--s-2); }
  :global(.js) .filters[hidden] { display: flex; }
  .timeline { padding: 0; }
  .timeline :global(.tl-entry[hidden]) { display: none; }
</style>


<script>
  const bar = document.querySelector<HTMLElement>('[data-filters]');
  const list = document.querySelector<HTMLElement>('[data-timeline]');
  const status = document.querySelector<HTMLElement>('[data-filter-status]');
  if (bar && list) {
    bar.hidden = false;
    const buttons = [...bar.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const entries = [...list.querySelectorAll<HTMLElement>('.tl-entry')];
    const apply = (f: string) => {
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === f)));
      let shown = 0;
      entries.forEach((e) => {
        const on = f === 'all' || (e.dataset.tags ?? '').split(' ').includes(f);
        e.hidden = !on;
        if (on) shown++;
      });
      if (status) status.textContent = `${shown}`;
    };
    buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.filter ?? 'all')));
  }
</script>
