---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import TimelineEntry from '@/components/TimelineEntry.astro';
import { useTranslations, type Locale } from '@/i18n';
import { localePath } from '@/i18n/routes';
import { experience } from '@/data/experience';
import { education, milestones } from '@/data/education';
import type { Kind } from '@/data/types';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);

interface Item {
  id: string; key: string; kind: Kind; period: string; title: string; org?: string; summary?: string;
  stack?: string[]; notesHref?: string; extraHref?: { href: string; label: string };
}

const items: Item[] = [
  ...experience.map((e) => ({
    id: e.id, key: e.start, kind: e.kind, period: e.period[lang], title: e.role[lang], org: e.org[lang],
    summary: e.summary[lang], stack: e.stack, notesHref: e.notesSlug ? localePath('notebook', lang, e.notesSlug) : undefined,
  })),
  ...education.map((e) => ({
    id: e.id, key: e.start, kind: 'study' as Kind, period: e.period[lang], title: e.degree[lang], org: e.location ? `${e.institution} · ${e.location[lang]}` : e.institution,
    summary: [e.details?.[lang], e.thesis ? `${t('education.thesis')}: ${e.thesis.title}.` : undefined, e.coursework ? `${t('education.coursework')}: ${e.coursework.map((c) => c[lang]).join(', ')}.` : undefined].filter(Boolean).join(' ') || undefined,
    extraHref: e.thesis ? { href: localePath('work', lang, 'apex'), label: t('education.caseStudy') } : undefined,
  })),
  ...milestones.map((m) => ({
    id: m.id, key: m.date, kind: 'milestone' as Kind, period: m.period[lang], title: m.title[lang], summary: m.details?.[lang],
    extraHref: m.id === 'ms-defence' ? { href: localePath('work', lang, 'apex'), label: t('education.caseStudy') } : undefined,
  })),
].sort((a, b) => b.key.localeCompare(a.key));

const kinds: Kind[] = ['work', 'study', 'teaching', 'community', 'milestone'];
const counts = Object.fromEntries(kinds.map((k) => [k, items.filter((i) => i.kind === k).length]));
---

<BaseLayout lang={lang} title={t('journey.metaTitle')} description={t('journey.description')}>
  <div class="container page-head">
    <SectionHeading n="02" label={t('nav.journey')} title={t('journey.title')} level="h1">
      <p class="lead intro">{t('journey.intro')}</p>
    </SectionHeading>

    <div class="filters" role="group" aria-label={t('journey.filter')} data-filters hidden>
      <button type="button" class="tab" aria-pressed="true" data-filter="all">{t('journey.all')} <span class="count">{items.length}</span></button>
      {kinds.map((k) => (
        <button type="button" class="tab" aria-pressed="false" data-filter={k} data-kind={k}>
          <span class="dot" aria-hidden="true"></span>{t(`tag.${k}` as const)} <span class="count">{counts[k]}</span>
        </button>
      ))}
    </div>
  </div>

  <div class="container">
    <ol class="timeline" role="list" data-timeline>
      {items.map((i) => (
        <TimelineEntry
          id={i.id}
          period={i.period}
          title={i.title}
          org={i.org}
          tags={[{ kind: i.kind, label: t(`tag.${i.kind}` as const) }]}
          stack={i.stack}
          notesHref={i.notesHref ?? i.extraHref?.href}
          notesLabel={i.notesHref ? t('cta.readNotes') : i.extraHref?.label}
        >
          {i.summary && <p>{i.summary}</p>}
        </TimelineEntry>
      ))}
    </ol>
    <p class="sr-only" aria-live="polite" data-filter-status></p>
  </div>
</BaseLayout>

<style>
  .page-head { padding-top: clamp(3rem, 2rem + 4vw, 5.5rem); }
  .intro { margin-top: var(--s-4); }
  .filters { display: flex; flex-wrap: wrap; gap: 0; margin: var(--s-2) 0 var(--s-7); border-bottom: 1px solid var(--rule-strong); }
  :global(.js) .filters[hidden] { display: flex; }
  /* Notebook index tabs */
  .tab {
    display: inline-flex; align-items: center; gap: 0.45em;
    margin-bottom: -1px; padding: 0.55rem 0.9rem;
    border: 1px solid transparent; border-bottom-color: var(--rule-strong);
    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
    background: transparent; color: var(--ink-2);
    font-family: var(--font-mono); font-size: var(--step--1); letter-spacing: var(--tracking-mono);
    min-height: 44px;
  }
  .tab:hover { color: var(--ink); }
  .tab[aria-pressed='true'] { color: var(--ink); background: var(--surface); border-color: var(--rule-strong); border-bottom-color: var(--surface); }
  .tab[aria-pressed='true']::before { content: ''; width: 4px; height: 4px; border-radius: 50%; background: var(--pen); }
  .count { color: var(--muted); font-size: 0.85em; }
  .dot { width: 7px; height: 7px; border-radius: 50%; }
  [data-kind='work'] .dot { background: var(--tag-work); }
  [data-kind='study'] .dot { box-shadow: inset 0 0 0 1.5px var(--tag-study); }
  [data-kind='teaching'] .dot { background: var(--tag-teaching); }
  [data-kind='community'] .dot { background: var(--tag-community); }
  [data-kind='milestone'] .dot { background: var(--tag-milestone); }
  .timeline { padding: 0; }
  .timeline :global(.tl-entry[hidden]) { display: none; }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-filters]');
  const list = document.querySelector<HTMLElement>('[data-timeline]');
  const status = document.querySelector<HTMLElement>('[data-filter-status]');
  if (bar && list) {
    bar.hidden = false;
    const buttons = [...bar.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const entries = [...list.querySelectorAll<HTMLElement>('.tl-entry')];
    const apply = (f: string) => {
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === f)));
      let shown = 0;
      entries.forEach((e) => {
        const on = f === 'all' || (e.dataset.tags ?? '').split(' ').includes(f);
        e.hidden = !on;
        if (on) { shown++; e.classList.add('is-visible'); }
      });
      if (status) status.textContent = `${shown}`;
    };
    buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.filter ?? 'all')));
  }
</script>
