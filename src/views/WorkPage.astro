---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import ApexFeature from '@/components/ApexFeature.astro';
import { useTranslations, type Locale } from '@/i18n';
import { getWork, cardProps } from '@/lib/work';
import { loc } from '@/data/types';
import { profile } from '@/data/links';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
const { featured, archive } = await getWork();
const [lead, ...rest] = featured;
---

<BaseLayout lang={lang} title={t('work.title')} description={t('work.description')}>
  <div class="container page-head">
    <SectionHeading n="04" label={t('nav.work')} title={t('work.pageTitle')} level="h1">
      <p class="lead intro">{t('work.intro')}</p>
    </SectionHeading>
  </div>

  <section class="container" aria-labelledby="featured-title">
    <h2 id="featured-title" class="sub">{t('work.featured')}</h2>
    <div class="featured">
      {lead && <ApexFeature lang={lang} {...cardProps(lead, lang)} />}
      <div class="grid">
        {rest.map((e) => <ProjectCard maxStack={4} {...cardProps(e, lang)} />)}
      </div>
    </div>
  </section>

  <section class="container archive-wrap" aria-labelledby="archive-title">
    <h2 id="archive-title" class="sub">{t('work.archive')}</h2>
    <p class="muted archive-intro">{t('work.archiveIntro')}</p>
    <div class="table-scroll">
      <table class="archive">
        <thead>
          <tr>
            <th scope="col">{t('work.year')}</th>
            <th scope="col">{t('work.project')}</th>
            <th scope="col" class="hide-sm">{t('work.oneLine')}</th>
            <th scope="col" class="hide-sm">{t('work.stack')}</th>
            <th scope="col"><span class="sr-only">{t('work.link')}</span></th>
          </tr>
        </thead>
        <tbody>
          {archive.map((e) => (
            <tr>
              <td class="date year">{e.data.year ?? ''}</td>
              <th scope="row" class="name">
                {loc(e.data.title, lang)}
                <span class="sm-line">{loc(e.data.summary, lang)}</span>
              </th>
              <td class="hide-sm line">{loc(e.data.summary, lang)}</td>
              <td class="hide-sm stack">{e.data.stack.join(', ')}</td>
              <td class="link">
                {e.data.links.repo && (
                  <a class="pen-link" href={e.data.links.repo} aria-label={`${t('work.repo')}: ${loc(e.data.title, lang)}`}>{t('work.repo')}</a>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <a class="pen-link more" href={profile.github}>{t('cta.moreOnGithub')}</a>
  </section>
</BaseLayout>

<style>
  .page-head { padding-top: var(--s-8); }
  .intro { margin-top: var(--s-3); }
  .sub { margin-bottom: var(--s-4); font-family: var(--font-body); letter-spacing: -0.01em; }
  .featured { display: grid; gap: var(--s-5); }
  .grid { display: grid; gap: var(--s-5); grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); }

  .archive-wrap { padding-top: var(--s-8); }
  .archive-intro { margin-bottom: var(--s-3); }
  .table-scroll { overflow-x: auto; }
  .archive { width: 100%; border-collapse: collapse; font-size: var(--t-16); }
  .archive th, .archive td { padding: var(--s-3) var(--s-3) var(--s-3) 0; border-bottom: 1px solid var(--rule); text-align: left; vertical-align: baseline; }
  .archive thead th { font-size: var(--t-14); font-weight: 400; color: var(--muted); border-bottom-color: var(--rule-strong); }
  .year { width: 4.5rem; }
  .name { font-weight: 500; color: var(--ink); }
  .line { color: var(--ink-2); }
  .stack { color: var(--ink-2); font-size: var(--t-14); }
  .link { text-align: right; white-space: nowrap; }
  .sm-line { display: none; }
  @media (max-width: 720px) {
    .hide-sm { display: none; }
    .sm-line { display: block; margin-top: var(--s-1); font-weight: 400; color: var(--ink-2); font-size: var(--t-14); }
  }
  .more { display: inline-block; margin-top: var(--s-5); font-size: var(--t-16); }
</style>
