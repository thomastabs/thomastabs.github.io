---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import PostCard from '@/components/PostCard.astro';
import { useTranslations, type Locale } from '@/i18n';
import { seriesParts, seriesLabel, cardProps, seriesHref, indexHref } from '@/lib/notebook';

interface Props { lang: Locale; series: string }
const { lang, series } = Astro.props;
const t = useTranslations(lang);
const other: Locale = lang === 'en' ? 'pt' : 'en';
const parts = await seriesParts(series, lang);
const otherHas = (await seriesParts(series, other)).length > 0;
const label = seriesLabel(series);
---

<BaseLayout lang={lang} title={`${label} · ${t('notebook.series')}`} description={`${t('notebook.series')}: ${label}.`} altHref={otherHas ? seriesHref(series, other) : indexHref(other)}>
  <div class="container page-head">
    <SectionHeading n="05" label={`${t('notebook.title')} · ${t('notebook.series')}`} title={label} level="h1">
      <p class="back"><a class="pen-link" href={indexHref(lang)}>← {t('notebook.backToIndex')}</a></p>
    </SectionHeading>
  </div>
  <div class="container">
    <ol class="parts" role="list">
      {parts.map((p, i) => (
        <li>
          <p class="kicker part">{t('notebook.seriesPart').replace('{n}', String(i + 1)).replace('{total}', String(parts.length))}</p>
          <PostCard {...cardProps(p, t)} />
        </li>
      ))}
    </ol>
  </div>
</BaseLayout>

<style>
  .page-head { padding-top: var(--s-8); }
  .back { font-size: var(--t-16); }
  .parts { padding: 0; list-style: none; border-top: 1px solid var(--rule-strong); max-width: var(--measure); }
  .part { padding-top: var(--s-5); margin-bottom: calc(var(--s-3) * -1); }
</style>
